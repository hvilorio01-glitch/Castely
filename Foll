        function saveSettings() {
            const sDate = document.getElementById('configStartDate').value;
            const sIdx = parseInt(document.getElementById('configStartShiftIndex').value) || 0;
            const patternStr = document.getElementById('configPattern').value;
            const adv = parseInt(document.getElementById('configAdvanceMin').value) || 20;

            if (!sDate || !patternStr) return alert("Completa todos los campos.");

            state.startDate = sDate;
            state.startIndex = sIdx;
            state.pattern = patternStr.split(',').map(s => s.trim()).filter(Boolean);
            state.advanceMin = adv;

            localStorage.setItem('sf_startDate', state.startDate);
            localStorage.setItem('sf_startIndex', state.startIndex);
            localStorage.setItem('sf_pattern', JSON.stringify(state.pattern));
            localStorage.setItem('sf_advance', state.advanceMin);

            closeSettingsModal();
            renderMonthlyCalendar();
            updateTodayShiftDisplay();
        }
    </script>
</body>
</html>
