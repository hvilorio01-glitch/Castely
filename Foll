        function renderMonthlyCalendar() {
            const grid = document.getElementById('monthlyGrid');
            grid.innerHTML = '';

            const year = state.currentDisplayMonth.getFullYear();
            const month = state.currentDisplayMonth.getMonth();

            // Month Label
            const monthName = state.currentDisplayMonth.toLocaleDateString(state.lang, { month: 'long', year: 'numeric' });
            document.getElementById('calendarMonthLabel').textContent = monthName;

            // First day of month & Days in month
            const firstDay = new Date(year, month, 1);
            const lastDay = new Date(year, month + 1, 0);
            
            // Adjust to Monday = 0
            let startingDay = firstDay.getDay() - 1;
            if (startingDay === -1) startingDay = 6;

            const totalDays = lastDay.getDate();

            // Render Empty Padding Cells
            for (let i = 0; i < startingDay; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.className = "h-14 rounded-xl bg-slate-900/30 border border-slate-900/50";
                grid.appendChild(emptyCell);
            }

            const todayStr = new Date().toISOString().split('T')[0];

            // Render Actual Month Days
            for (let day = 1; day <= totalDays; day++) {
                const currentObj = new Date(year, month, day);
                const dateKey = currentObj.toISOString().split('T')[0];
                const shiftInfo = getShiftInfoForDate(currentObj);

                let cellClass = "cell-rest";
                if(shiftInfo.category === 'morning') cellClass = "cell-morning";
                else if(shiftInfo.category === 'afternoon') cellClass = "cell-afternoon";
                else if(shiftInfo.category === 'night') cellClass = "cell-night";

                const isToday = (dateKey === todayStr);
                const hasNote = Boolean(state.notes[dateKey]);

                const dayCell = document.createElement('div');
                dayCell.className = `h-14 p-1 rounded-xl border flex flex-col justify-between cursor-pointer transition active:scale-95 relative overflow-hidden ${cellClass} ${isToday ? 'ring-2 ring-accentBlue font-black' : ''}`;
                dayCell.onclick = () => openNoteModal(dateKey, currentObj, shiftInfo);

                dayCell.innerHTML = `
                    <div class="flex justify-between items-center text-[10px] font-black">
                        <span>${day}</span>
                        ${hasNote ? '<span class="w-2 h-2 rounded-full bg-accentAmber animate-ping"></span><span class="w-2 h-2 rounded-full bg-accentAmber absolute top-1 right-1"></span>' : ''}
                    </div>
                    <div class="text-[9px] font-bold tracking-tight truncate leading-tight">${shiftInfo.name}</div>
                    ${hasNote ? `<div class="text-[8px] truncate text-amber-300 font-semibold"><i class="fa-solid fa-sticky-note"></i> ${state.notes[dateKey]}</div>` : '<div></div>'}
                `;
                grid.appendChild(dayCell);
            }
        }

