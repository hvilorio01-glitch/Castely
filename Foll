        // --- Continuous Shift Calculation with Starting Offset ---
        function getShiftInfoForDate(targetDate) {
            const start = new Date(state.startDate);
            const target = new Date(targetDate);
            start.setHours(0,0,0,0);
            target.setHours(0,0,0,0);
            
            const diffTime = target - start;
            const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
            
            const patternLength = state.pattern.length;
            // Calculate index with offset
            let rawIndex = (diffDays + state.startIndex) % patternLength;
            if (rawIndex < 0) rawIndex += patternLength;
            
            const shiftName = state.pattern[rawIndex];
            const lower = shiftName.toLowerCase();

            // Color Categorization
            let category = "rest"; // default
            if (lower.includes("mañana") || lower.includes("mattina") || lower.includes("morn")) {
                category = "morning";
            } else if (lower.includes("tarde") || lower.includes("pomeriggio") || lower.includes("aft")) {
                category = "afternoon";
            } else if (lower.includes("noche") || lower.includes("notte") || lower.includes("night")) {
                category = "night";
            }

            return { name: shiftName, category, index: rawIndex };
        }

        function updateTodayShiftDisplay() {
            const today = new Date();
            const shiftInfo = getShiftInfoForDate(today);
            const t = i18n[state.lang];
            
            const badge = document.getElementById('currentShiftBadge');
            badge.textContent = `${t.todayShift} ${shiftInfo.name}`;

            if(shiftInfo.category === 'morning') badge.className = "text-xs font-semibold px-2.5 py-1 rounded-lg badge-morning";
            else if(shiftInfo.category === 'afternoon') badge.className = "text-xs font-semibold px-2.5 py-1 rounded-lg badge-afternoon";
            else if(shiftInfo.category === 'night') badge.className = "text-xs font-semibold px-2.5 py-1 rounded-lg badge-night";
            else badge.className = "text-xs font-semibold px-2.5 py-1 rounded-lg badge-rest";
        }

        // --- Full Colored Monthly Calendar Grid ---
        function changeMonth(delta) {
